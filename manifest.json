{
  "manifest_version": 3,
  "name": "和暦⇔西暦 変換",
  "version": "3.0.0",
  "description": "ページ上で和暦・西暦を選択すると、変換結果をツールチップで表示し、クリックでコピーできます。",
  "permissions": [],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
